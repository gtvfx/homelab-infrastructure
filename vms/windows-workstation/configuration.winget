$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3
resources:
- type: Microsoft.WinGet/Package
  name: PowerShell
  properties:
    acceptAgreements: true
    id: Microsoft.PowerShell
    source: winget
    useLatest: true
  metadata:
    description: Install the current stable PowerShell 7 release

- type: Microsoft.WinGet/Package
  name: WindowsTerminal
  properties:
    acceptAgreements: true
    id: Microsoft.WindowsTerminal
    source: winget
    useLatest: true
  metadata:
    description: Install or update Windows Terminal

- type: Microsoft.WinGet/Package
  name: Git
  properties:
    acceptAgreements: true
    id: Git.Git
    source: winget
    useLatest: true
  metadata:
    description: Install Git for Windows

- type: Microsoft.WinGet/Package
  name: CopilotCli
  properties:
    acceptAgreements: true
    id: GitHub.Copilot
    source: winget
    useLatest: true
  metadata:
    description: Install GitHub Copilot CLI without configuring authentication

- type: Microsoft.WinGet/Package
  name: VisualCppRedistributableX64
  properties:
    acceptAgreements: true
    id: Microsoft.VCRedist.2015+.x64
    source: winget
    useLatest: true
  metadata:
    description: Install the current x64 Visual C++ v14 redistributable

- type: Microsoft.WinGet/Package
  name: VisualCppRedistributableX86
  properties:
    acceptAgreements: true
    id: Microsoft.VCRedist.2015+.x86
    source: winget
    useLatest: true
  metadata:
    description: Install the current x86 Visual C++ v14 redistributable

- type: Microsoft.WinGet/Package
  name: DotNetSdk10
  properties:
    acceptAgreements: true
    id: Microsoft.DotNet.SDK.10
    source: winget
    useLatest: true
  metadata:
    description: Install the latest .NET 10 SDK and matching runtime
